# ---------------------------------------------------------------------------
# Ledgerforge environment configuration
#
# Copy to `.env.local` for development. Never commit a filled-in copy.
# Every variable is validated at startup by src/lib/env.ts; production refuses to
# boot with development defaults for the security-critical ones.
# ---------------------------------------------------------------------------

# --- PUBLIC / GENERAL ------------------------------------------------------
NODE_ENV=development
# Canonical origin. Used for absolute URLs, sitemap entries, magic-link targets
# and cookie scope. Must be the real https origin in production.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- DATABASE (server only) ------------------------------------------------
# Required in production; a value pointing at localhost with the default password
# is rejected at boot.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerforge
DATABASE_POOL_MAX=10

# --- CACHE (server only, optional) -----------------------------------------
# When unset, an in-process cache is used. That is correct for a single instance
# but shares nothing between replicas — set this before scaling horizontally.
# REDIS_URL=redis://localhost:6379

# --- SIM COMPANIES UPSTREAM (server only) ----------------------------------
SIMCOMPANIES_BASE_URL=https://www.simcompanies.com
# Identify yourself. The API is undocumented and unsupported; being reachable is
# the minimum courtesy owed to the operators whose servers we are using.
SIMCOMPANIES_USER_AGENT=Ledgerforge/0.1 (+https://ledgerforge.app; independent Sim Companies companion)
# Process-wide floor between two upstream requests, in milliseconds.
UPSTREAM_MIN_INTERVAL_MS=1100
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_RETRIES=2
# Set to false to run entirely from cache/database with no outbound game traffic
# (CI, offline development, incident response).
UPSTREAM_ENABLED=true

# --- INGESTION (worker process) --------------------------------------------
# Only the worker should set this to true. Web replicas must leave it false or
# every replica will collect duplicate snapshots.
WORKER_ENABLED=false
MARKET_SNAPSHOT_INTERVAL_MINUTES=15
CATALOG_SYNC_INTERVAL_MINUTES=720

# --- AUTH (server only) ----------------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
# AUTH_SECRET=
SESSION_TTL_DAYS=30

# --- EMAIL (server only, optional) -----------------------------------------
# Without SMTP, magic links are written to the server log in development and
# account sign-in is disabled in production.
# SMTP_URL=smtp://user:password@smtp.example.com:587
EMAIL_FROM=Ledgerforge <no-reply@ledgerforge.app>

# --- ADMIN (server only) ---------------------------------------------------
# Comma-separated emails granted access to /admin.
ADMIN_EMAILS=
