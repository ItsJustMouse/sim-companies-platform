NODE_ENV=production
APP_URL=https://ledgerforge.example
LOG_LEVEL=info

POSTGRES_PASSWORD=replace-with-random-production-password
DATABASE_POOL_MAX=10

AUTH_SECRET=replace-with-a-production-auth-secret-at-least-32-bytes-long

SIMCOMPANIES_BASE_URL=https://www.simcompanies.com
SIMCOMPANIES_USER_AGENT=Ledgerforge/0.1 (+https://ledgerforge.example; independent Sim Companies companion)

UPSTREAM_MIN_INTERVAL_MS=300000
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_RETRIES=0

MARKET_SNAPSHOT_INTERVAL_MINUTES=15
CATALOG_SYNC_INTERVAL_MINUTES=720

SESSION_TTL_DAYS=30
EMAIL_FROM=Ledgerforge <no-reply@ledgerforge.example>
ADMIN_EMAILS=
